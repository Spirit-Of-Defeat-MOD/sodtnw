{
  "name": "Vaporwave",
  "id": "vaporwave",
  "version": 2,
  "description": "Midnight purple with magenta-violet-cyan gradients, deep cyan selections, lavender text and chrome pastel icons.",
  "colors": {
    "background": "#100d20",
    "surface": "#1c1731",
    "sidebar": "#171127",
    "foreground": "#f3edff",
    "muted": "#c6b4df",
    "border": "#826ba6",
    "copper": "#ff9cda",
    "header_background": "#40214f",
    "header_foreground": "#fff0fc",
    "header_hover": "#573060",
    "stripe": "#22213c",
    "selection_background": "#1d5365",
    "selection_foreground": "#f4feff",
    "button_background": "#32244e",
    "button_foreground": "#fff1fc",
    "button_active": "#473466",
    "parchment_foreground": "#fff1fc",
    "input_background": "#0d1020",
    "input_foreground": "#f3edff",
    "age_green": "#9fe2bb",
    "age_yellow": "#f4d589",
    "age_red": "#ffa3b6",
    "blocked_background": "#44283e",
    "button_pressed": "#1d5365",
    "button_pressed_foreground": "#f4feff"
  },
  "fonts": {
    "family": "Segoe UI",
    "mono_family": "Consolas"
  },
  "assets": {
    "button": { "file": "assets/button.png", "size": [160, 40] },
    "section_header": { "file": "assets/section_header.png", "size": [1024, 48] },
    "sidebar": { "file": "assets/sidebar.png", "size": [256, 1024] },
    "backdrop": { "file": "assets/backdrop.png", "size": [1280, 800] },
    "accent_strip": { "file": "assets/accent_strip.png", "size": [1024, 6] }
  },
  "gradients": {
    "button": { "direction": "vertical", "stops": [[0, "#47315f"], [0.5, "#35204f"], [1, "#193d4c"]] },
    "section_header": { "direction": "horizontal", "stops": [[0, "#52264f"], [0.5, "#35244f"], [1, "#183c4b"]] },
    "sidebar": { "direction": "vertical", "stops": [[0, "#281537"], [0.5, "#171127"], [1, "#112b37"]] },
    "backdrop": { "direction": "diagonal", "stops": [[0, "#24132f"], [0.5, "#100d20"], [1, "#102c35"]] },
    "accent_strip": { "direction": "horizontal", "stops": [[0, "#ff80ca"], [0.5, "#b79bff"], [1, "#68e5ee"]] }
  },
  "asset_notes": "Gradient PNGs are generated from the stops above. Existing ui.py supports assets.button; header, sidebar, backdrop, accent_strip and gradients metadata are prepared for Claude to integrate. Solid palette values remain usable fallbacks."
}
